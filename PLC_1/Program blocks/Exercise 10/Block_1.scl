FUNCTION "Block_1" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      prevTankLevel : DInt;
   END_VAR


BEGIN
	
	CASE "Global DB".Process_Step OF
	        
	    1:
	        "tank fill"(eqp:= "Global DB".Valve1,
	                timer:="IEC_Timer_0_DB_9",
	                tank:="Global DB".Tank1);
	    IF("IEC_Timer_0_DB_9".Q) THEN
	        "Global DB".Process_Step += 1;
	    END_IF
	        ;
	      
	       
	    2:
	        
	        "heat"(eqp := "Global DB".Heater,
	                  timer := "IEC_Timer_0_DB_5",
	                  tank := "Global DB".Tank1);
	        ;
	        
	        
	    3:
	        "mix"(eqp := "Global DB".Mixer,
	                  timer := "IEC_Timer_0_DB_6",
	                  tank := "Global DB".Tank1);
	        ;
	        
	        
	    4:
	 
	        IF ("Global DB".Process_Count < 5) THEN
	            
	            
	            "tank fill"(eqp := "Global DB".Valve2,
	                        timer := "IEC_Timer_0_DB_7",
	                        tank := "Global DB".Tank2);
	            
	            ;
	            
	           "tank empty"(eqp:="Global DB".Valve2,
	                         timer:="IEC_Timer_0_DB_7",
	                         tank:= "Global DB".Tank1);
	            
	            ;
	
	        
	            
	        END_IF;
	        
	    
	        
	     5:
	
	                    
	            
	            "tank empty"(eqp := "Global DB".Valve3,
	                         timer := "IEC_Timer_0_DB_8",
	                         tank := "Global DB".Tank2);
	            
	            
	            
	         
	
	        
	END_CASE;
	
	"timers"();
	
	"tanks"();
	
	
	
END_FUNCTION

